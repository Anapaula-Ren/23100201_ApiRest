doctype html
html
  head
    meta(charset='utf-8')
    title= titulo
  body
    main(id='vista')
      h1= titulo1
      h2= mensaje
      p
        a(href='/api-docs') Abrir documentación interactiva (Swagger)
      p
      input(type='password', id='apiKey', placeholder='API key')
      p= titulo2
      button(type='button', id='consultarRecetas')= ruta1
      pre(id='respuestaJson')

    script.
      const inputApiKey = document.getElementById('apiKey');
      const respuestaJson = document.getElementById('respuestaJson');

      document.getElementById('consultarRecetas').addEventListener('click', async () => {
        try {
          const respuesta = await fetch('/recetas', {
            headers: { 'x-api-key': inputApiKey.value.trim() }
          });
          const datos = await respuesta.json();

          if (!respuesta.ok) {
            throw new Error(datos.error?.mensaje || datos.mensaje || 'Error al consultar la API');
          }

          respuestaJson.textContent = JSON.stringify(datos, null, 2);
        } catch (error) {
          respuestaJson.textContent = JSON.stringify({ mensaje: error.message }, null, 2);
        }
      });
